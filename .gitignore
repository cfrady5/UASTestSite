node_modules/
.DS_Store
*.log
# Upstream geodata downloads. tools/fetch_geo.py caches the raw files here and
# writes the committed Indiana extracts to tools/geo-src/; the raw files are
# 5-50 MB each and have no business in the repository.
tools/.geo-cache/

# Python bytecode from the build scripts.
__pycache__/
*.pyc

# Camera originals for the launch photographs. tools/prepare_photos.py reads
# them from here and writes the committed crops to assets/img/; the originals
# are 11-13 MB each and have no business in the repository.
tools/photo-src/
